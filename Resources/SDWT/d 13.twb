      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Sum Calc' datatype='real' name='[Calculation_227994746732253184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3]==&quot;Profit&quot;&#13;&#10;    THEN SUM([Profit])&#13;&#10;ELSEIF [Parameters].[Parameter 3]==&quot;Sales&quot;&#13;&#10;    THEN SUM([Sales])&#13;&#10;ELSEIF [Parameters].[Parameter 3]==&quot;Quantity&quot;&#13;&#10;    THEN SUM([Quantity])&#13;&#10;ELSE&#13;&#10;    SUM([Discount])&#13;&#10;END' />
      </column>
      <column caption='Calc Profit' datatype='real' name='[Calculation_227994746735419393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4]==&quot;Sum&quot;&#13;&#10;    THEN SUM([Sales])&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&quot;Min&quot;&#13;&#10;    THEN MIN([Sales])&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&quot;Max&quot;&#13;&#10;    THEN MAX([Sales])&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&quot;Count&quot;&#13;&#10;    THEN COUNT([Sales])&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&quot;CountD&quot;&#13;&#10;    THEN COUNTD([Sales])&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&quot;Average&quot;&#13;&#10;    THEN AVG([Sales])&#13;&#10;ELSE&#13;&#10;    MEDIAN([Sales])&#13;&#10;END' />
      </column>
